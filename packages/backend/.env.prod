# Production environment for the math-practice backend.
# Supply to the container with:  docker run --env-file packages/backend/.env.prod ...
# All keys use the MATH_PRACTICE_ prefix (see settings.py).
#
# This is a TEMPLATE: replace the placeholder values. Keep real secrets
# (e.g. a Postgres password) OUT of version control.

# Allowed browser origins for the separately-hosted static client.
# JSON array, no spaces. Set to your static site's exact origin(s).
MATH_PRACTICE_CORS_ALLOW_ORIGINS=["https://app.your-domain.com"]

# API-only host: do not try to serve the SPA from the backend.
MATH_PRACTICE_SERVE_WEB=false

# Persistent storage so sessions/trials survive restarts.
# Default below is file-SQLite on the /data volume (single instance).
MATH_PRACTICE_DATABASE_URL=sqlite+pysqlite:////data/math.db
# Postgres alternative (multi-instance capable) — requires adding a driver
# such as "psycopg[binary]" to packages/backend/pyproject.toml dependencies:
# MATH_PRACTICE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Session retention window (hours) and expired-session sweeper cadence (seconds).
MATH_PRACTICE_SESSION_TTL_HOURS=24
MATH_PRACTICE_SWEEPER_INTERVAL_SECONDS=600
